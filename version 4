<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Rachan Mall — curious about almost everything.</title>

<meta
name="description"
content="Rachan Mall — curious about almost everything. Thoughts, experiments, things built, rabbit holes and things still becoming."
>

<style>

@import url(
'https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Serif+Display:ital@0;1&family=Inter:wght@400;500;600&display=swap'
);


/* =========================================
   VARIABLES
========================================= */

:root {

    --bg: #f2f0ea;
    --paper: #f7f5ef;
    --ink: #11110f;
    --muted: #77756d;
    --line: #d6d2c8;
    --accent: #7650e8;

}


/* =========================================
   GLOBAL
========================================= */

* {
    box-sizing: border-box;
}


html {
    scroll-behavior: smooth;
}


body {

    margin: 0;

    background: var(--bg);

    color: var(--ink);

    font-family:
        Inter,
        Arial,
        sans-serif;

    line-height: 1.55;

}


/* subtle grid */

body::after {

    content: "";

    position: fixed;

    inset: 0;

    pointer-events: none;

    opacity: 0.025;

    background-image:

        linear-gradient(
            #111 1px,
            transparent 1px
        ),

        linear-gradient(
            90deg,
            #111 1px,
            transparent 1px
        );

    background-size: 80px 80px;

    z-index: 50;

}


a {

    color: inherit;

    text-decoration: none;

}


.wrap {

    width:
        min(
            1180px,
            calc(100% - 44px)
        );

    margin: auto;

}


/* =========================================
   NAVIGATION
========================================= */

nav {

    height: 82px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    border-bottom:
        1px solid var(--line);

}


.logo {

    font-family:
        "DM Mono",
        monospace;

    font-size: 14px;

    font-weight: 500;

}


.logo span {

    color:
        var(--accent);

}


.nav {

    display: flex;

    gap: 25px;

    font-family:
        "DM Mono",
        monospace;

    font-size: 12px;

    color:
        var(--muted);

}


.nav a {

    transition: 0.2s;

}


.nav a:hover {

    color:
        var(--ink);

}


/* =========================================
   HERO
========================================= */

.hero {

    min-height:
        calc(100vh - 82px);

    display:
        grid;

    align-items:
        center;

    padding:
        90px 0 110px;

}


.hero-grid {

    display:
        grid;

    grid-template-columns:
        1.35fr
        0.65fr;

    gap:
        70px;

    align-items:
        end;

}


.kicker {

    font-family:
        "DM Mono",
        monospace;

    font-size:
        11px;

    color:
        var(--muted);

    text-transform:
        uppercase;

    letter-spacing:
        0.08em;

    margin-bottom:
        25px;

}


.hero h1 {

    font-family:
        "DM Serif Display",
        Georgia,
        serif;

    font-size:
        clamp(
            70px,
            10vw,
            145px
        );

    line-height:
        0.83;

    letter-spacing:
        -0.07em;

    font-weight:
        normal;

    margin:
        0;

}


.hero h1 em {

    color:
        var(--accent);

}


.hero-copy {

    max-width:
        410px;

    color:
        #5f5d56;

    font-size:
        15px;

}


.hero-copy p {

    margin:
        0 0 22px;

}


.meta-line {

    margin-top:
        30px;

    font-family:
        "DM Mono",
        monospace;

    font-size:
        10px;

    color:
        #8a867e;

}


.scroll {

    display:
        inline-flex;

    gap:
        10px;

    align-items:
        center;

    border-bottom:
        1px solid var(--ink);

    padding-bottom:
        5px;

}


.scroll span {

    color:
        var(--accent);

}


/* =========================================
   SECTIONS
========================================= */

section {

    padding:
        120px 0;

    border-top:
        1px solid var(--line);

}


.section-top {

    display:
        grid;

    grid-template-columns:
        180px
        1fr;

    gap:
        50px;

    margin-bottom:
        60px;

}


.label {

    font-family:
        "DM Mono",
        monospace;

    font-size:
        11px;

    color:
        var(--muted);

    text-transform:
        uppercase;

    letter-spacing:
        0.08em;

}


.section-title {

    font-family:
        "DM Serif Display",
        Georgia,
        serif;

    font-size:
        clamp(
            40px,
            5.5vw,
            72px
        );

    line-height:
        0.98;

    letter-spacing:
        -0.055em;

    font-weight:
        normal;

    margin:
        0;

    max-width:
        900px;

}


.section-title em {

    font-style:
        italic;

    color:
        #66635d;

}


/* =========================================
   THINKING
========================================= */

.thoughts {

    display:
        grid;

    grid-template-columns:
        repeat(
            2,
            1fr
        );

    gap:
        1px;

    background:
        var(--line);

    border:
        1px solid var(--line);

}


.thought {

    background:
        var(--paper);

    min-height:
        240px;

    padding:
        34px;

    display:
        flex;

    flex-direction:
        column;

    justify-content:
        space-between;

    transition:
        0.3s;

}


.thought:hover {

    background:
        #ece9e1;

}


.thought-number {

    font-family:
        "DM Mono",
        monospace;

    font-size:
        10px;

    color:
        #99958c;

}


.thought p {

    font-family:
        "DM Serif Display",
        Georgia,
        serif;

    font-size:
        clamp(
            25px,
            3vw,
            38px
        );

    line-height:
        1.05;

    letter-spacing:
        -0.035em;

    margin:
        40px 0 0;

}


/* =========================================
   PROJECTS
========================================= */

.project {

    border-top:
        1px solid var(--line);

    padding:
        45px 0;

    display:
        grid;

    grid-template-columns:
        150px
        1fr
        auto;

    gap:
        35px;

    align-items:
        start;

    transition:
        0.25s;

}


.project:last-child {

    border-bottom:
        1px solid var(--line);

}


.project:hover
.project-name {

    transform:
        translateX(8px);

}


.project-num {

    font-family:
        "DM Mono",
        monospace;

    font-size:
        11px;

    color:
        var(--muted);

}


.project-name {

    font-family:
        "DM Serif Display",
        Georgia,
        serif;

    font-size:
        clamp(
            32px,
            4vw,
            55px
        );

    line-height:
        1;

    letter-spacing:
        -0.045em;

    transition:
        0.25s;

}


.project-desc {

    max-width:
        620px;

    color:
        #6e6b63;

    margin-top:
        14px;

    font-size:
        14px;

}


.project-meta {

    font-family:
        "DM Mono",
        monospace;

    font-size:
        11px;

    line-height:
        1.8;

    color:
        var(--muted);

    text-align:
        right;

}


.project-meta strong {

    color:
        var(--ink);

    font-weight:
        500;

}


.project-link {

    display:
        inline-block;

    margin-top:
        16px;

    color:
        var(--accent);

    font-family:
        "DM Mono",
        monospace;

    font-size:
        11px;

}


/* =========================================
   CURRENTLY
========================================= */

.current {

    display:
        grid;

    grid-template-columns:
        1fr
        1fr;

    gap:
        1px;

    background:
        var(--line);

    border:
        1px solid var(--line);

}


.current-box {

    background:
        var(--paper);

    padding:
        42px;

}


.current-box h3 {

    margin:
        0 0 25px;

    font-family:
        "DM Serif Display",
        Georgia,
        serif;

    font-size:
        32px;

    font-weight:
        normal;

}


.current-list {

    margin:
        0;

    padding:
        0;

    list-style:
        none;

}


.current-list li {

    padding:
        13px 0;

    border-bottom:
        1px solid var(--line);

    font-size:
        14px;

    color:
        #65625b;

}


.current-list li::before {

    content:
        "→";

    color:
        var(--accent);

    margin-right:
        12px;

}


/* =========================================
   INTERSECTION
========================================= */

.intersection {

    margin-top:
        80px;

    border:
        1px solid var(--line);

    background:
        var(--paper);

    padding:
        45px;

}


.intersection-title {

    font-family:
        "DM Serif Display",
        Georgia,
        serif;

    font-size:
        clamp(
            34px,
            4vw,
            55px
        );

    line-height:
        1;

    letter-spacing:
        -0.045em;

    margin:
        0 0 30px;

}


.intersection-grid {

    display:
        grid;

    grid-template-columns:
        repeat(
            5,
            1fr
        );

    gap:
        1px;

    background:
        var(--line);

    border:
        1px solid var(--line);

}


.intersection-item {

    background:
        var(--paper);

    padding:
        22px;

    min-height:
        100px;

    display:
        flex;

    align-items:
        flex-end;

    font-family:
        "DM Mono",
        monospace;

    font-size:
        12px;

}


.intersection-item span {

    color:
        var(--accent);

    margin-right:
        7px;

}


/* =========================================
   ABOUT
========================================= */

.about {

    display:
        grid;

    grid-template-columns:
        1fr
        1fr;

    gap:
        90px;

}


.about-big {

    font-family:
        "DM Serif Display",
        Georgia,
        serif;

    font-size:
        clamp(
            34px,
            4vw,
            54px
        );

    line-height:
        1.08;

    letter-spacing:
        -0.045em;

    margin:
        0;

}


.about-text {

    color:
        #66635c;

    max-width:
        510px;

}


.about-text p {

    margin-top:
        0;

    margin-bottom:
        22px;

}


.note {

    margin-top:
        40px;

    border-left:
        2px solid var(--accent);

    padding-left:
        18px;

    font-family:
        "DM Mono",
        monospace;

    font-size:
        12px;

    line-height:
        1.7;

    color:
        #77736b;

}


/* =========================================
   CONTRADICTIONS
========================================= */

.contradictions {

    margin-top:
        90px;

}


.contradiction-grid {

    display:
        grid;

    grid-template-columns:
        repeat(
            2,
            1fr
        );

    border-top:
        1px solid var(--line);

}


.contradiction {

    padding:
        22px 0;

    border-bottom:
        1px solid var(--line);

    font-family:
        "DM Mono",
        monospace;

    font-size:
        14px;

    color:
        #68655e;

}


.contradiction:nth-child(odd) {

    padding-right:
        35px;

    border-right:
        1px solid var(--line);

}


.contradiction:nth-child(even) {

    padding-left:
        35px;

}


.contradiction b {

    color:
        var(--ink);

    font-weight:
        500;

}


/* =========================================
   RABBIT HOLES
========================================= */

.rabbit-holes {

    margin-top:
        90px;

}


.rabbit-grid {

    display:
        grid;

    grid-template-columns:
        repeat(
            3,
            1fr
        );

    gap:
        1px;

    background:
        var(--line);

    border:
        1px solid var(--line);

}


.rabbit {

    background:
        var(--paper);

    padding:
        30px;

    min-height:
        190px;

}


.rabbit small {

    font-family:
        "DM Mono",
        monospace;

    font-size:
        10px;

    color:
        var(--muted);

}


.rabbit h4 {

    font-family:
        "DM Serif Display",
        Georgia,
        serif;

    font-size:
        27px;

    line-height:
        1;

    margin:
        35px 0 10px;

    font-weight:
        normal;

}


.rabbit p {

    font-size:
        13px;

    color:
        #77736b;

    margin:
        0;

}


/* =========================================
   TIMELINE
========================================= */

.timeline {

    margin-top:
        90px;

}


.timeline-row {

    display:
        grid;

    grid-template-columns:
        100px
        1fr;

    gap:
        35px;

    padding:
        22px 0;

    border-bottom:
        1px solid var(--line);

}


.timeline-year {

    font-family:
        "DM Mono",
        monospace;

    font-size:
        11px;

    color:
        var(--accent);

}


.timeline-text {

    font-size:
        14px;

    color:
        #65625b;

}


.timeline-text strong {

    color:
        var(--ink);

}


/* =========================================
   BELIEFS
========================================= */

.beliefs {

    margin-top:
        90px;

}


.belief {

    padding:
        25px 0;

    border-bottom:
        1px solid var(--line);

    display:
        grid;

    grid-template-columns:
        80px
        1fr;

    gap:
        25px;

}


.belief-number {

    font-family:
        "DM Mono",
        monospace;

    font-size:
        10px;

    color:
        var(--accent);

}


.belief-text {

    font-family:
        "DM Serif Display",
        Georgia,
        serif;

    font-size:
        clamp(
            22px,
            3vw,
            34px
        );

    line-height:
        1.08;

    letter-spacing:
        -0.03em;

}


/* =========================================
   TERMINAL
========================================= */

.terminal {

    margin-top:
        70px;

    background:
        #171614;

    color:
        #d9d6ce;

    border-radius:
        3px;

    overflow:
        hidden;

    box-shadow:
        0 18px 60px
        rgba(
            0,
            0,
            0,
            0.12
        );

}


.term-head {

    padding:
        11px 15px;

    border-bottom:
        1px solid #34312c;

    font-family:
        "DM Mono",
        monospace;

    font-size:
        10px;

    color:
        #77736b;

}


.term-body {

    padding:
        25px;

    font-family:
        "DM Mono",
        monospace;

    font-size:
        12px;

    line-height:
        2;

}


.purple {

    color:
        #b79aff;

}


.term-green {

    color:
        #b8ff8a;

}


.term-muted {

    color:
        #77736b;

}


/* =========================================
   CONTACT
========================================= */

.contact {

    min-height:
        70vh;

    display:
        flex;

    flex-direction:
        column;

    justify-content:
        space-between;

}


.contact-title {

    font-family:
        "DM Serif Display",
        Georgia,
        serif;

    font-size:
        clamp(
            60px,
            10vw,
            135px
        );

    line-height:
        0.85;

    letter-spacing:
        -0.07em;

    font-weight:
        normal;

    margin:
        0;

}


.contact-title em {

    color:
        var(--accent);

}


.contact-bottom {

    display:
        flex;

    justify-content:
        space-between;

    align-items:
        flex-end;

    gap:
        30px;

}


.contact-copy {

    max-width:
        410px;

    color:
        #6d6a62;

}


.contact-links {

    display:
        flex;

    gap:
        25px;

    flex-wrap:
        wrap;

    font-family:
        "DM Mono",
        monospace;

    font-size:
        11px;

}


.contact-links a {

    border-bottom:
        1px solid var(--ink);

    padding-bottom:
        4px;

}


.contact-links a:hover {

    color:
        var(--accent);

    border-color:
        var(--accent);

}


/* =========================================
   FOOTER
========================================= */

footer {

    padding:
        28px 0;

    border-top:
        1px solid var(--line);

    display:
        flex;

    justify-content:
        space-between;

    color:
        #8a867e;

    font-family:
        "DM Mono",
        monospace;

    font-size:
        10px;

}


/* =========================================
   ANIMATION
========================================= */

.reveal {

    opacity:
        0;

    transform:
        translateY(25px);

    transition:
        opacity 0.8s ease,
        transform 0.8s ease;

}


.reveal.show {

    opacity:
        1;

    transform:
        translateY(0);

}


/* =========================================
   MOBILE
========================================= */

@media (
    max-width: 760px
) {

    .wrap {

        width:
            min(
                100% - 30px,
                1180px
            );

    }


    .nav {

        display:
            none;

    }


    .hero {

        padding:
            65px 0 90px;

    }


    .hero-grid {

        grid-template-columns:
            1fr;

        gap:
            55px;

    }


    .hero h1 {

        font-size:
            clamp(
                65px,
                19vw,
                105px
            );

    }


    section {

        padding:
            85px 0;

    }


    .section-top {

        grid-template-columns:
            1fr;

        gap:
            15px;

        margin-bottom:
            40px;

    }


    .thoughts {

        grid-template-columns:
            1fr;

    }


    .current {

        grid-template-columns:
            1fr;

    }


    .about {

        grid-template-columns:
            1fr;

    }


    .intersection {

        padding:
            25px;

    }


    .intersection-grid {

        grid-template-columns:
            1fr 1fr;

    }


    .rabbit-grid {

        grid-template-columns:
            1fr;

    }


    .thought {

        min-height:
            190px;

    }


    .project {

        grid-template-columns:
            45px
            1fr;

        gap:
            15px;

        padding:
            32px 0;

    }


    .project-meta {

        grid-column:
            2;

        text-align:
            left;

    }


    .contradiction-grid {

        grid-template-columns:
            1fr;

    }


    .contradiction:nth-child(odd) {

        padding-right:
            0;

        border-right:
            0;

    }


    .contradiction:nth-child(even) {

        padding-left:
            0;

    }


    .timeline-row {

        grid-template-columns:
            65px
            1fr;

        gap:
            20px;

    }


    .belief {

        grid-template-columns:
            45px
            1fr;

    }


    .contact {

        min-height:
            65vh;

    }


    .contact-bottom {

        display:
            block;

    }


    .contact-links {

        margin-top:
            40px;

    }


    footer {

        display:
            block;

    }


    footer span {

        display:
            block;

        margin-bottom:
            8px;

    }

}

</style>

</head>


